# Copy this file to .env and fill in real values. Never commit .env.

# Free OpenRouter API key from https://openrouter.ai/keys  (no card required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use. Defaults to Nemotron 3 Super (:free) if unset — the best free
# model on OpenRouter as of Sept 2026 for structured JSON output.
# NOTE: leave the value EMPTY or unset to use the default; a non-empty value
# overrides it.
OPENROUTER_MODEL=

# HubSpot private app token (free CRM). Settings -> Integrations -> Private Apps.
# Scopes: crm.objects.companies.read/write, crm.objects.contacts.read/write,
# crm.objects.deals.read/write. Blank = deals go to eval/logs/crm_mock.json.
HUBSPOT_TOKEN=

# Hosted deploys only (Render, Railway...): there is no browser for OAuth, so
# authorize locally once, then paste the full contents of token.json here.
GOOGLE_TOKEN_JSON=

# Composio API key (https://platform.composio.dev). Enables the in-app "Connect"
# buttons so each user links their own Gmail, Google Calendar, HubSpot and Slack.
# Connected apps take priority over the server keys below.
COMPOSIO_API_KEY=

# Default Slack channel for Composio-connected Slack (users can override in the app).
SLACK_CHANNEL=

# Slack Incoming Webhook URL — posts a message whenever a run completes
# (proceeded automatically, or flagged for review). Create one at
# https://api.slack.com/messaging/webhooks — no OAuth app review needed.
# Leave blank to log notifications locally instead.
SLACK_WEBHOOK_URL=

# Guardrail keyword-overlap threshold (0.0 - 1.0). Below this -> flagged for review.
GUARDRAIL_THRESHOLD=0.40

# Auto-send gate (0.0 - 1.0). At/above this AND above GUARDRAIL_THRESHOLD,
# Gmail sends the drafted application automatically instead of leaving it
# as a draft for you to review and send yourself. Deliberately stricter
# than GUARDRAIL_THRESHOLD — this is a second, higher bar on top of it.
AUTO_SEND_THRESHOLD=0.70
